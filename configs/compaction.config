{
  "compaction_enabled": true,
  "tool_result_budget": {
    "enabled": true,
    "max_result_chars": 50000,
    "per_message_chars": 200000,
    "preview_chars": 2000,
    "storage_dir": "./artifacts/tool-results"
  },
  "snip": {
    "enabled": true,
    "nudge_ratio": 0.7
  },
  "micro": {
    "enabled": true,
    "gap_threshold_minutes": 60,
    "keep_recent": 5
  },
  "collapse": {
    "enabled": false,
    "commit_ratio": 0.9
  },
  "auto": {
    "enabled": true,
    "threshold_tokens": 8000,
    "max_consecutive_failures": 3
  },
  "reactive": {
    "enabled": true
  },
  "amnesia_guard": {
    "enabled": true,
    "max_restore_files": 5
  }
}
