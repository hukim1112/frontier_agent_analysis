{
  "compaction_enabled": true,
  "snip": {
    "enabled": true,
    "age_threshold": 2,
    "max_snippet_chars": 80
  },
  "micro": {
    "enabled": true,
    "max_chars": 5000,
    "swap_dir": "./artifacts/swaps"
  },
  "collapse": {
    "enabled": true,
    "min_consecutive": 3,
    "swap_dir": "./artifacts/swaps"
  },
  "auto": {
    "enabled": true,
    "threshold_tokens": 8000
  },
  "reactive": {
    "enabled": true,
    "slice_ratio": 0.20
  },
  "amnesia_guard": {
    "enabled": true,
    "max_restore_files": 5
  }
}
