{
  "mcp_enabled": true,
  "connect_timeout_s": 60,
  "servers": {
    "wikipedia": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "wikipedia-mcp"],
      "instructions": "Local Wikipedia MCP server (spawned via npx). Use mcp__wikipedia__search to find articles by keyword, then mcp__wikipedia__readArticle with the exact title (or pageId) to read the full content. Prefer it over web scraping for encyclopedic facts.",
      "tool_descriptions": {
        "search": "Search Wikipedia articles by keyword. Returns matching article titles, snippets and links.",
        "readArticle": "Read the full content of a Wikipedia article by its exact title or page ID."
      }
    }
  }
}
