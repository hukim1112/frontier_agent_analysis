{
  "semantic_memory": {
    "enabled": true,
    "memory_dir": "./artifacts/users/default/memory",
    "auto_review": true
  },
  "episodic_memory": {
    "enabled": true,
    "db_path": "./app/database/episodic.db",
    "top_k_prefetch": 2,
    "auto_finalize": true,
    "finalize_idle_settle_s": 15,
    "finalize_max_age_s": 1800
  },
  "transcript": {
    "enabled": true,
    "db_path": "./app/database/transcript.db",
    "recall_max_chars": 2000
  }
}
