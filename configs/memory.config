{
  "semantic_memory": {
    "enabled": true,
    "memory_dir": "./artifacts/users/default/memory",
    "auto_review": true,
    "memory_nudge_interval": 1
  },
  "episodic_memory": {
    "enabled": true,
    "db_path": "./app/database/episodic.db",
    "top_k_prefetch": 2,
    "auto_finalize": true,
    "finalize_idle_settle_s": 15,
    "finalize_max_age_s": 1800
  },
  "procedural_memory": {
    "enabled": true,
    "skills_dir": "./artifacts/users/default/skills",
    "skill_nudge_interval": 10,
    "review_max_iterations": 16,
    "max_skill_chars": 20000
  },
  "transcript": {
    "enabled": true,
    "db_path": "./app/database/transcript.db",
    "recall_max_chars": 2000
  }
}
