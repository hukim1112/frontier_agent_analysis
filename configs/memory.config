{
  "checkpoint_db_path": "./app/database/checkpoints.db",
  "semantic_memory": {
    "enabled": true,
    "memory_dir": "./app/database",
    "user_path": "./app/database/USER.md",
    "memory_path": "./app/database/MEMORY.md",
    "auto_review": true
  },
  "episodic_memory": {
    "enabled": true,
    "db_path": "./artifacts/memory/episodic.db",
    "top_k_prefetch": 2,
    "auto_finalize": true
  }
}
