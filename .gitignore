# ===============================================================================
# agent-harness-lab .gitignore
# ===============================================================================

# ── Byte-compiled / optimized / DLL files ──
__pycache__/
*.py[cod]
*$py.class

# ── Environments & Secrets ──
.env
.venv
venv/
ENV/
env/

# ── Databases & Caching ──
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# ── Logs ──
*.log

# ── Task tracking & State ──
task.md
task_state.json
plan_state.json
TASK.md

# ── Jupyter Notebook ──
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── IDEs ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Test / Experiment residues ──
samples/
scratch/
sandbox/
output/

# ── Chainlit runtime files ──
.files/

# ── Agent artifacts (에이전트가 생성하는 런타임 산출물) ──
artifacts/runs/
artifacts/data/
artifacts/screenshots/
artifacts/temporary/
artifacts/reports/
artifacts/charts/
artifacts/analyst_test/
artifacts/logs/
artifacts/memory/
artifacts/swaps/
artifacts/visualizations/
artifacts/visuals/
artifacts/*.png
artifacts/*.html
artifacts/*.csv
artifacts/*.xlsx
artifacts/*.md
artifacts/users/*/sessions/

# ── Preserved Seed Assets (교육생 실습용 스킬 풀 및 기본 유저 시드 메모리는 Git 추적 유지) ──
!artifacts/skills_pool/
!artifacts/skills_pool/**
!artifacts/users/default/memory/
!artifacts/users/default/memory/USER.md
!artifacts/users/default/memory/MEMORY.md

# ── Browser automation temp files ──
bu_cdp_*/

# ── OS generated files ──
.DS_Store
Thumbs.db
desktop.ini
