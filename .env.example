# ===============================================================================
# Agent Harness Lab Environment Configuration (Vertex AI & Gemini Activated)
# ===============================================================================

DEFAULT_MODEL_NAME=gemini-3.8-flash

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith Observability Keys (Unified under LANGCHAIN_ prefix)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=common_test

# Chainlit Auth Secret
CHAINLIT_AUTH_SECRET=your_chainlit_secret_here

# ===============================================================================
# Browser Display Configuration (Navigator Tools)
# ===============================================================================
# HEADLESS: 브라우저 화면 표시 여부
#   true  → 화면 없이 백그라운드 실행 (기본값, 서버/CI 환경)
#   false → 브라우저 창을 화면에 표시 (로컬 데스크톱 또는 noVNC)
HEADLESS=true

# DISPLAY: headed 모드(HEADLESS=false)에서 브라우저를 표시할 디스플레이
#   로컬 데스크톱 (WSLg/Linux GUI): 주석 유지 (시스템 디스플레이 자동 사용)
#   Codespaces + noVNC: 주석 해제하여 가상 디스플레이 지정
# DISPLAY=":1"